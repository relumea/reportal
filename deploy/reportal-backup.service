# One-shot workspace backup for reportal.
#
# This file is a template, not an installed unit: copy it beside
# reportal-backup.timer into /etc/systemd/system/, replace /srv/reportal and
# /srv/backups with the workspace and a directory outside that workspace, then
# `systemctl daemon-reload && systemctl enable --now reportal-backup.timer`.
# docs/DEPLOY.md and docs/DR_RUNBOOK.md describe the schedule and the restore.
#
# The archive must leave the workspace directory: a backup written under
# /srv/reportal is lost with the same instance wipe that takes the live data.
# The unit fails loud on a zero-byte archive or a file whose manifest
# `reportal backup-info` refuses, so a silent credential, disk, or truncate
# failure shows up in `systemctl --failed` and the journal.  After a good
# write it prunes archives older than 14 days so logical-corruption recovery
# keeps a bounded window without filling the volume.

[Unit]
Description=reportal workspace backup
Documentation=https://github.com/relumea/reportal/blob/main/docs/DR_RUNBOOK.md
After=local-fs.target

[Service]
Type=oneshot
User=reportal
Group=reportal
WorkingDirectory=/srv/reportal
UMask=0077
Environment=PYTHONUNBUFFERED=1
LimitCORE=0
# %%Y%%m%%dT%%H%%M%%SZ is systemd's escape for date(1) UTC stamps.  A full
# instant (not just the calendar day) keeps a same-day re-run from overwriting
# the earlier archive that logical-corruption recovery may still need.
# OnCalendar=... UTC on the timer matches the -u clock.
ExecStart=/bin/sh -c 'out=/srv/backups/reportal-$(date -u +%%Y%%m%%dT%%H%%M%%SZ).tar.gz; bin=/srv/reportal/.venv/bin/reportal; "$bin" backup --output "$out" && test -s "$out" && "$bin" backup-info "$out" >/dev/null && "$bin" backup-prune --dir /srv/backups --keep-days 14'
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Bound a runaway SQLite backup so a stuck oneshot cannot starve the host.
MemoryMax=1G
TasksMax=64
TimeoutStartSec=30min
SyslogIdentifier=reportal-backup

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/srv/reportal /srv/backups
KeyringMode=private
RemoveIPC=true
