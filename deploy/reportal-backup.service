# One-shot workspace backup for reportal.
#
# This file is a template, not an installed unit: copy it beside
# reportal-backup.timer into /etc/systemd/system/, replace /srv/reportal and
# /srv/backups with the workspace and a directory outside that workspace, then
# `systemctl daemon-reload && systemctl enable --now reportal-backup.timer`.
# docs/DEPLOY.md and docs/DR_RUNBOOK.md describe the schedule and the restore.
#
# The archive must leave the workspace directory: a backup written under
# /srv/reportal is lost with the same instance wipe that takes the live data.
# The unit fails loud on a zero-byte archive so a silent credential or disk
# failure shows up in `systemctl --failed` and the journal.

[Unit]
Description=reportal workspace backup
Documentation=https://github.com/relumea/reportal/blob/main/docs/DR_RUNBOOK.md
After=local-fs.target

[Service]
Type=oneshot
User=reportal
Group=reportal
WorkingDirectory=/srv/reportal
UMask=0077
# %%F is systemd's escape for date(1) %F (YYYY-MM-DD).  -u pins the name to the
# UTC calendar day so a host TZ cannot rename or overwrite across a local-midnight
# boundary (matches OnCalendar=... UTC on the timer).
ExecStart=/bin/sh -c 'out=/srv/backups/reportal-$(date -u +%%F).tar.gz; /srv/reportal/.venv/bin/reportal backup --output "$out" && test -s "$out"'
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Bound a runaway SQLite backup so a stuck oneshot cannot starve the host.
MemoryMax=1G
TasksMax=64
TimeoutStartSec=30min

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/srv/reportal /srv/backups
KeyringMode=private
RemoveIPC=true
