{
  "options": {
    "typeAware": false
  },
  "plugins": [
    "eslint",
    "import",
    "jsdoc",
    "jsx-a11y",
    "node",
    "oxc",
    "promise",
    "react",
    "react-perf",
    "typescript",
    "unicorn",
    "vitest"
  ],
  "rules": {
    "oxc/no-barrel-file": [
      "warn",
      {
        "threshold": 0
      }
    ],
    "oxc/no-async-await": "off",
    "oxc/no-accumulating-spread": "warn",
    "eslint/eqeqeq": [
      "warn",
      "always"
    ],
    "eslint/no-unused-expressions": "warn",
    "eslint/no-sequences": "warn",
    "eslint/no-unreachable": "warn",
    "eslint/no-constant-condition": "warn",
    "eslint/func-names": "off",
    "eslint/no-undefined": "off",
    "eslint/sort-imports": "off",
    "eslint/sort-keys": "off",
    "eslint/no-extend-native": "warn",
    "eslint/no-global-assign": "warn",
    "eslint/no-implicit-globals": "warn",
    "eslint/use-isnan": "warn",
    "eslint/no-compare-neg-zero": "warn",
    "eslint/no-case-declarations": "warn",
    "eslint/no-fallthrough": "warn",
    "eslint/default-case": "warn",
    "eslint/no-unsafe-finally": "warn",
    "eslint/no-void": "off",
    "eslint/no-script-url": "warn",
    "eslint/no-prototype-builtins": "warn",
    "unicorn/no-object-as-default-parameter": "warn",
    "unicorn/no-useless-fallback-in-spread": "warn",
    "import/no-cycle": "warn",
    "import/no-self-import": "warn",
    "import/no-duplicates": "warn",
    "import/group-exports": "off",
    "import/no-default-export": "off",
    "import/no-named-export": "off",
    "import/no-relative-parent-imports": "off",
    "import/exports-last": "off",
    "import/prefer-default-export": "off",
    "import/consistent-type-specifier-style": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/no-meaningless-void-operator": "warn",
    "typescript/no-duplicate-enum-values": "warn",
    "typescript/prefer-optional-chain": "warn",
    "typescript/no-misused-new": "warn",
    "typescript/no-non-null-asserted-optional-chain": "warn",
    "promise/no-callback-in-promise": "warn",
    "promise/no-return-in-finally": "warn",
    "promise/no-multiple-resolved": "warn",
    "unicorn/no-abusive-eslint-disable": "warn",
    "unicorn/consistent-function-scoping": "warn",
    "unicorn/filename-case": "off",
    "unicorn/no-array-for-each": "warn",
    "unicorn/no-null": "off",
    "unicorn/error-message": "warn",
    "unicorn/catch-error-name": [
      "warn",
      {
        "name": "error"
      }
    ],
    "unicorn/throw-new-error": "warn",
    "unicorn/prefer-node-protocol": "warn",
    "unicorn/prefer-module": "warn",
    "unicorn/numeric-separators-style": "warn",
    "unicorn/prefer-structured-clone": "warn",
    "unicorn/prefer-string-replace-all": "warn",
    "unicorn/no-thenable": "warn",
    "unicorn/no-useless-switch-case": "warn",
    "unicorn/no-useless-undefined": "off",
    "unicorn/no-useless-spread": "warn",
    "unicorn/no-document-cookie": "warn",
    "unicorn/new-for-builtins": "warn",
    "unicorn/no-instanceof-builtins": "warn",
    "unicorn/no-invalid-remove-event-listener": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-unsafe-assignment": "warn",
    "typescript/no-unsafe-call": "warn",
    "typescript/no-unsafe-member-access": "warn",
    "typescript/no-unsafe-return": "warn",
    "typescript/no-unsafe-argument": "warn",
    "typescript/no-unnecessary-type-assertion": "warn",
    "typescript/strict-boolean-expressions": "warn",
    "typescript/switch-exhaustiveness-check": "warn",
    "typescript/explicit-function-return-type": "off",
    "typescript/explicit-module-boundary-types": "off",
    "typescript/no-import-type-side-effects": "warn",
    "typescript/unbound-method": "warn",
    "typescript/no-misused-spread": "warn",
    "typescript/no-unnecessary-condition": "warn",
    "typescript/prefer-nullish-coalescing": "warn",
    "typescript/require-await": "warn",
    "typescript/no-unsafe-declaration-merging": "warn",
    "typescript/no-unnecessary-qualifier": "warn",
    "import/first": "warn",
    "import/no-absolute-path": "warn",
    "import/no-mutable-exports": "warn",
    "import/no-commonjs": "warn",
    "import/no-dynamic-require": "warn",
    "import/max-dependencies": [
      "warn",
      {
        "max": 35
      }
    ],
    "@rikalabs/no-import-then-reexport": "warn",
    "promise/no-nesting": "warn",
    "promise/no-new-statics": "warn",
    "promise/param-names": "warn",
    "promise/valid-params": "warn",
    "promise/catch-or-return": "warn",
    "promise/always-return": "off",
    "typescript/no-floating-promises": "warn",
    "typescript/promise-function-async": "off",
    "typescript/return-await": "off",
    "promise/prefer-await-to-then": "off",
    "@rikalabs/no-vague-verbs": "warn",
    "@rikalabs/no-duplicate-context": "warn",
    "@rikalabs/no-is-record-helpers": "warn",
    "@rikalabs/no-as-never": "warn",
    "@rikalabs/no-placeholder-implementation": "warn",
    "@rikalabs/no-disable-without-rationale": "warn",
    "@rikalabs/no-todo-without-issue": "warn",
    "@rikalabs/no-anemic-errors": "warn",
    "@rikalabs/no-low-signal-public-names": "warn",
    "@rikalabs/no-generic-module-names": "warn",
    "@rikalabs/no-identical-branches": "warn",
    "@rikalabs/no-copy-paste-exports": "warn",
    "@rikalabs/no-trivial-runtime-guard-helpers": "warn",
    "@rikalabs/no-trivial-property-helpers": "warn",
    "@rikalabs/no-bare-wrapper-functions": "warn",
    "@rikalabs/no-pass-through-intermediate-vars": "warn",
    "@rikalabs/no-redundant-const-assertion": "warn",
    "@rikalabs/no-tutorial-comments": "warn",
    "@rikalabs/no-commented-out-code": "warn",
    "@rikalabs/no-debug-residue-filenames": "warn",
    "@rikalabs/no-low-signal-variable-names": "warn",
    "@rikalabs/no-standalone-classes": "warn",
    "@rikalabs/no-hardcoded-secrets": "warn",
    "@rikalabs/no-sql-string-concat": "warn",
    "typescript/consistent-type-imports": "warn",
    "typescript/no-misused-promises": "warn",
    "typescript/use-unknown-in-catch-callback-variable": "warn",
    "typescript/no-unsafe-type-assertion": "warn",
    "typescript/no-redundant-type-constituents": "warn",
    "typescript/no-deprecated": "warn",
    "typescript/ban-ts-comment": [
      "warn",
      {
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-expect-error": {
          "descriptionFormat": "^: .+"
        }
      }
    ],
    "typescript/restrict-plus-operands": "warn",
    "typescript/no-confusing-void-expression": [
      "warn",
      {
        "ignoreArrowShorthand": true
      }
    ],
    "typescript/no-confusing-non-null-assertion": "warn",
    "typescript/no-unnecessary-boolean-literal-compare": "off",
    "typescript/no-unnecessary-type-arguments": "warn",
    "typescript/no-unnecessary-type-constraint": "warn",
    "typescript/prefer-for-of": "warn",
    "typescript/prefer-includes": "warn",
    "typescript/consistent-type-assertions": [
      "warn",
      {
        "assertionStyle": "as"
      }
    ],
    "typescript/no-empty-object-type": "warn",
    "typescript/no-require-imports": "warn",
    "typescript/no-namespace": "warn",
    "typescript/array-type": [
      "warn",
      {
        "default": "generic"
      }
    ],
    "import/no-anonymous-default-export": "warn",
    "promise/no-return-wrap": "warn",
    "eslint/array-callback-return": "warn",
    "eslint/no-useless-return": "warn",
    "eslint/no-await-in-loop": "off",
    "eslint/no-continue": "off",
    "eslint/no-negated-condition": "off",
    "eslint/no-param-reassign": "warn",
    "eslint/no-empty": "warn",
    "eslint/no-useless-catch": "warn",
    "eslint/no-empty-function": "warn",
    "eslint/require-yield": "off",
    "eslint/no-ternary": "off",
    "eslint/no-console": "warn",
    "eslint/no-warning-comments": "warn",
    "eslint/no-shadow": [
      "warn",
      {
        "hoist": "functions"
      }
    ],
    "eslint/no-return-assign": "warn",
    "eslint/no-loop-func": "warn",
    "eslint/no-self-compare": "warn",
    "eslint/no-constructor-return": "warn",
    "eslint/no-alert": "warn",
    "eslint/no-new-func": "warn",
    "eslint/curly": [
      "warn",
      "all"
    ],
    "eslint/no-else-return": "warn",
    "eslint/no-implicit-coercion": [
      "warn",
      {
        "boolean": true,
        "number": true,
        "string": true
      }
    ],
    "eslint/no-multi-assign": "warn",
    "eslint/no-template-curly-in-string": "warn",
    "eslint/no-labels": "warn",
    "eslint/no-lone-blocks": "warn",
    "eslint/id-length": "off",
    "eslint/max-statements": "off",
    "eslint/new-cap": "off",
    "eslint/prefer-object-has-own": "warn",
    "eslint/prefer-object-spread": "off",
    "eslint/prefer-template": "warn",
    "eslint/max-params": "off",
    "eslint/max-depth": "off",
    "eslint/max-lines-per-function": [
      "warn",
      {
        "max": 60,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "eslint/max-classes-per-file": [
      "warn",
      1
    ],
    "eslint/max-lines": [
      "warn",
      {
        "max": 1500,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "eslint/complexity": "off",
    "eslint/no-magic-numbers": "off",
    "eslint/no-nested-ternary": "warn",
    "eslint/no-debugger": "warn",
    "eslint/no-eval": "warn",
    "eslint/no-implied-eval": "warn",
    "eslint/prefer-promise-reject-errors": "warn",
    "eslint/max-nested-callbacks": [
      "warn",
      4
    ],
    "@rikalabs/no-silent-catch-fallback": "warn",
    "@rikalabs/no-runtime-compat-fallbacks": "warn",
    "@rikalabs/no-catch-return-error-object": "warn",
    "@rikalabs/no-unlisted-external-imports": "warn",
    "@rikalabs/no-double-type-assertion": "warn",
    "@rikalabs/no-ai-debt-comments": "warn",
    "@rikalabs/no-json-parse-default-fallback": "warn",
    "@rikalabs/no-json-stringify-default-fallback": "warn",
    "typescript/consistent-type-definitions": [
      "warn",
      "type"
    ],
    "unicorn/no-static-only-class": "warn",
    "unicorn/no-useless-promise-resolve-reject": "warn",
    "oxc/no-optional-chaining": "off",
    "oxc/no-rest-spread-properties": "off",
    "oxc/no-map-spread": "off",
    "node/no-process-env": "warn",
    "node/no-path-concat": "warn",
    "node/handle-callback-err": "warn",
    "vitest/no-conditional-tests": "warn",
    "vitest/no-import-node-test": "warn",
    "vitest/prefer-called-once": "warn",
    "vitest/consistent-test-filename": "warn",
    "vitest/prefer-called-times": "warn",
    "vitest/prefer-to-be-falsy": "warn",
    "vitest/prefer-to-be-truthy": "warn",
    "vitest/prefer-to-be-object": "warn",
    "jsdoc/check-tag-names": "warn",
    "jsdoc/check-property-names": "warn",
    "jsdoc/check-access": "warn",
    "jsdoc/empty-tags": "warn",
    "jsdoc/implements-on-classes": "warn",
    "jsdoc/no-defaults": "off",
    "jsdoc/require-property": "warn",
    "jsdoc/require-property-description": "warn",
    "jsdoc/require-property-name": "warn",
    "jsdoc/require-yields": "warn",
    "jsdoc/require-param": "off",
    "jsdoc/require-param-type": "off",
    "jsdoc/require-returns": "off",
    "jsdoc/require-returns-type": "off",
    "@rikalabs/no-placeholder-tests": "warn",
    "@rikalabs/no-mock-only-tests": "warn",
    "react/button-has-type": "warn",
    "react/exhaustive-deps": "warn",
    "react/jsx-filename-extension": "off",
    "react/jsx-max-depth": "off",
    "react/jsx-key": "warn",
    "react/jsx-no-constructed-context-values": "warn",
    "react/jsx-no-script-url": "warn",
    "react/jsx-no-target-blank": "warn",
    "react/no-danger-with-children": "warn",
    "react/no-multi-comp": "off",
    "react/no-array-index-key": "off",
    "react/void-dom-elements-no-children": "warn",
    "react/iframe-missing-sandbox": "warn",
    "react/jsx-no-comment-textnodes": "warn",
    "react/jsx-no-useless-fragment": "warn",
    "react/no-unknown-property": "warn",
    "react/no-danger": "warn",
    "react/self-closing-comp": "warn",
    "react/jsx-pascal-case": "warn",
    "react/jsx-boolean-value": "warn",
    "react/checked-requires-onchange-or-readonly": "warn",
    "react/rules-of-hooks": "warn",
    "react/no-unescaped-entities": "warn",
    "react/jsx-curly-brace-presence": "warn",
    "react/jsx-fragments": "warn",
    "react/jsx-props-no-spreading": "off",
    "react/jsx-props-no-spread-multi": "warn",
    "react/no-children-prop": "warn",
    "react/forward-ref-uses-ref": "warn",
    "react/no-this-in-sfc": "warn",
    "react/style-prop-object": "warn",
    "react/react-in-jsx-scope": "off",
    "react-perf/jsx-no-jsx-as-prop": "warn",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-array-as-prop": "warn",
    "jsx-a11y/alt-text": "warn",
    "jsx-a11y/anchor-is-valid": "warn",
    "jsx-a11y/no-autofocus": "warn",
    "jsx-a11y/no-aria-hidden-on-focusable": "warn",
    "jsx-a11y/click-events-have-key-events": "warn",
    "jsx-a11y/heading-has-content": "warn",
    "jsx-a11y/aria-props": "warn",
    "jsx-a11y/aria-role": "warn",
    "jsx-a11y/no-static-element-interactions": "warn",
    "jsx-a11y/no-noninteractive-tabindex": "warn",
    "jsx-a11y/iframe-has-title": "warn",
    "jsx-a11y/role-has-required-aria-props": "warn",
    "jsx-a11y/tabindex-no-positive": "warn",
    "jsx-a11y/aria-activedescendant-has-tabindex": "warn",
    "jsx-a11y/aria-unsupported-elements": "warn",
    "jsx-a11y/autocomplete-valid": "warn",
    "jsx-a11y/html-has-lang": "warn",
    "jsx-a11y/img-redundant-alt": "warn",
    "jsx-a11y/lang": "warn",
    "jsx-a11y/media-has-caption": "warn",
    "jsx-a11y/no-access-key": "warn",
    "jsx-a11y/no-distracting-elements": "warn",
    "jsx-a11y/no-redundant-roles": "warn",
    "jsx-a11y/prefer-tag-over-role": "warn",
    "jsx-a11y/scope": "warn",
    "jsx-a11y/anchor-has-content": "warn",
    "jsx-a11y/role-supports-aria-props": "warn",
    "jsx-a11y/aria-proptypes": "warn",
    "jsx-a11y/no-interactive-element-to-noninteractive-role": "warn",
    "jsx-a11y/mouse-events-have-key-events": "warn",
    "jsx-a11y/label-has-associated-control": "warn",
    "@rikalabs/react-no-inline-effect-run": "warn"
  },
  "overrides": [
    {
      "files": [
        "**/scripts/**/*.{ts,tsx,mts,cts,mjs,cjs}",
        "**/*.config.{ts,mts,cts,js,mjs,cjs}",
        "**/tools/**/*.{ts,tsx,mts,cts}"
      ],
      "rules": {
        "eslint/no-console": "off"
      }
    },
    {
      "files": [
        "**/*.{test,spec}.{ts,tsx,mts,cts}",
        "**/__tests__/**/*.{ts,tsx,mts,cts}"
      ],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ]
}
